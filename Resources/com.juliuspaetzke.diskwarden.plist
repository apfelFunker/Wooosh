<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.juliuspaetzke.diskwarden</string>

	<key>ProgramArguments</key>
	<array>
		<string>__BINARY__</string>
		<string>--daemon</string>
	</array>

	<!-- Beim Login starten und dauerhaft laufen lassen. -->
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>

	<!-- Niemals vor dem System um Ressourcen konkurrieren: der Sweep ist
	     Hintergrundarbeit und darf beliebig lange dauern. -->
	<key>ProcessType</key>
	<string>Background</string>
	<key>Nice</key>
	<integer>10</integer>
	<key>LowPriorityIO</key>
	<true/>
	<key>LowPriorityBackgroundIO</key>
	<true/>

	<!-- Nach einem Absturz nicht in einer Schleife neu starten. -->
	<key>ThrottleInterval</key>
	<integer>60</integer>

	<key>StandardOutPath</key>
	<string>__LOGDIR__/launchd.out.log</string>
	<key>StandardErrorPath</key>
	<string>__LOGDIR__/launchd.err.log</string>
</dict>
</plist>
