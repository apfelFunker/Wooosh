<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Verteilung außerhalb des App Store: signiert mit
	     "Developer ID Application". -->
	<key>method</key>
	<string>developer-id</string>

	<key>teamID</key>
	<string>9FZVQ84P7B</string>

	<key>signingStyle</key>
	<string>automatic</string>

	<!-- "export" legt die signierte App ab, ohne sie hochzuladen. Die
	     Notarisierung übernimmt anschließend notarytool, damit sich Signieren
	     und Notarisieren getrennt nachvollziehen lassen. -->
	<key>destination</key>
	<string>export</string>
</dict>
</plist>
