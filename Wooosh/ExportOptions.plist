<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Distribution outside the App Store: signed with
	     "Developer ID Application". -->
	<key>method</key>
	<string>developer-id</string>

	<!-- build-release.sh writes $DEVELOPMENT_TEAM in here and puts the result
	     under .build; this file stays without a team ID. -->
	<key>teamID</key>
	<string>__TEAM_ID__</string>

	<key>signingStyle</key>
	<string>automatic</string>

	<!-- "export" writes out the signed app without uploading it. notarytool
	     takes care of notarising afterwards, so that signing and notarising can
	     be followed separately. -->
	<key>destination</key>
	<string>export</string>
</dict>
</plist>
